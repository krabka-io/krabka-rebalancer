module(
    name = "krabka_rebalancer",
    version = "0.4.1",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rs", version = "0.0.110")
bazel_dep(name = "rules_rs_mutants", version = "0.1.1")
bazel_dep(name = "llvm", version = "0.8.18")
bazel_dep(name = "aspect_rules_lint", version = "2.9.0")
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.2")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4")

single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//bazel/patches:rules-rs-target-has-atomic.patch"],
    version = "0.0.110",
)

git_override(
    module_name = "rules_rs_mutants",
    commit = "63bb99ca9a7cb81eab1728bc5d2c9985f23c8560",
    remote = "https://github.com/robot-head/rules_rs_mutants",
)

single_version_override(
    module_name = "aspect_rules_lint_rust",
    patch_strip = 1,
    patches = ["//bazel/patches:aspect-rules-lint-rust-toolchain-pattern.patch"],
    version = "0.0.2",
)

register_toolchains("@llvm//toolchain:all")

# Container image. See //packaging.
#
# apko builds the Wolfi base from a lock file. rules_img layers the Bazel-built
# rebalancer binary on that base, loads the image into a local daemon and pushes
# it to the registry. krabka-broker and krabka-gateway use the same arrangement.
bazel_dep(name = "rules_img", version = "0.3.20")
bazel_dep(name = "rules_apko", version = "1.5.56")

# `sh_test`, for the checks on the image layers.
bazel_dep(name = "rules_shell", version = "0.8.0")

apko = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko.toolchain(apko_version = "v1.2.40")
apko.translate_lock(
    name = "rebalancer_base_lock",
    lock = "//packaging:base.apko.lock.json",
)
use_repo(apko, "apko_toolchains", "rebalancer_base_lock")

register_toolchains("@apko_toolchains//:all")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    name = "krabka_rust_toolchains",
    edition = "2024",
    rustfmt_version = "nightly/2026-08-14",
    version = "1.98.1",
)
use_repo(toolchains, "default_rust_toolchains", "krabka_rust_toolchains")

register_toolchains("@krabka_rust_toolchains//...")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    crate = "krabka-protocol",
    gen_build_script = "off",
)
crate.from_cargo(
    name = "mutants",
    cargo_lock = "//tools/mutants:Cargo.lock",
    cargo_toml = "//tools/mutants:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.annotation(
    crate = "cargo-mutants",
    gen_binaries = ["cargo-mutants"],
    repositories = ["mutants"],
)
use_repo(crate, "crates", "mutants")

# Source members of first-party workspaces whose member list uses a glob.
[
    crate.annotation(
        crate = name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for name, directory in {
        "krabka-client-admin": "crates/client-admin",
        "krabka-client-core": "crates/client-core",
        "krabka-compression": "crates/compression",
        "krabka-ids": "crates/ids",
        "krabka-metadata": "crates/metadata",
        "krabka-security": "crates/security",
        "krabka-units": "crates/units",
        "krabka-voters": "crates/voters",
    }.items()
]
